{
  "name": "@ce-monorepo/core-api",
  "projectType": "application",
  "root": "apps/core-api",
  "sourceRoot": "apps/core-api/src",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/core-api",
        "format": ["cjs", "esm"],
        "bundle": true,
        "main": "apps/core-api/src/main.ts",
        "tsConfig": "apps/core-api/tsconfig.app.json",
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          },
          "external": [
            "hbs",
            "@nestjs/microservices",
            "@nestjs/websockets",
            "class-transformer/storage"
          ]
        },
        "minify": true,
        "target": "node18",
        "external": []
      },
      "configurations": {
        "development": {
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "external": [
              "hbs",
              "@nestjs/microservices",
              "@nestjs/websockets",
              "class-transformer/storage"
            ]
          }
        },
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            },
            "external": [
              "hbs",
              "@nestjs/microservices",
              "@nestjs/websockets",
              "class-transformer/storage"
            ]
          }
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "@ce-monorepo/core-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@ce-monorepo/core-api:build:development"
        },
        "production": {
          "buildTarget": "@ce-monorepo/core-api:build:production"
        }
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/apps/core-api",
        "main": "apps/core-api/src/main.ts",
        "tsConfig": "apps/core-api/tsconfig.app.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/core-api/src/**/*.ts",
          "apps/core-api/src/**/*.tsx"
        ]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.coverage.reportsDirectory}"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/core-api"
      }
    }
  },
  "tags": []
}
