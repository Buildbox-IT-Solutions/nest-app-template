{
  "name": "@ce-monorepo/core-api",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ce-monorepo/shared": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/core-api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@ce-monorepo/core-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@ce-monorepo/core-api:build:development"
          },
          "production": {
            "buildTarget": "@ce-monorepo/core-api:build:production"
          }
        }
      },
      "typecheck": {
        "executor": "@nx/js:tsc",
        "options": {
          "outputPath": "dist/apps/core-api",
          "main": "apps/core-api/src/main.ts",
          "tsConfig": "apps/core-api/tsconfig.app.json"
        }
      },
      "lint": {
        "executor": "@nx/eslint:lint",
        "outputs": [
          "{options.outputFile}"
        ],
        "options": {
          "lintFilePatterns": [
            "apps/core-api/src/**/*.ts",
            "apps/core-api/src/**/*.tsx"
          ]
        }
      },
      "test": {
        "executor": "@nx/vite:test",
        "outputs": [
          "{options.coverage.reportsDirectory}"
        ],
        "options": {
          "passWithNoTests": true,
          "reportsDirectory": "../../coverage/apps/core-api"
        }
      },
      "docker-build": {
        "dependsOn": [
          "build"
        ],
        "command": "docker build -f apps/core-api/Dockerfile . -t ce-monorepo-core-api"
      }
    }
  }
}
