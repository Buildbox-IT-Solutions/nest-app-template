{
  "name": "@ce-monorepo/core-api",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ce-monorepo/shared": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "platform": "node",
          "outputPath": "dist/apps/core-api",
          "format": [
            "cjs",
            "esm"
          ],
          "bundle": true,
          "main": "apps/core-api/src/main.ts",
          "tsConfig": "apps/core-api/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          },
          "minify": true,
          "target": "node18",
          "external": []
        },
        "configurations": {
          "development": {
            "esbuildOptions": {
              "sourcemap": true,
              "outExtension": {
                ".js": ".js"
              }
            }
          },
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@ce-monorepo/core-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@ce-monorepo/core-api:build:development"
          },
          "production": {
            "buildTarget": "@ce-monorepo/core-api:build:production"
          }
        }
      },
      "docker-build": {
        "dependsOn": [
          "build"
        ],
        "command": "docker build -f apps/core-api/Dockerfile . -t ce-monorepo-core-api"
      }
    }
  }
}
